<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.foryou.catalog-media-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/nice</string>
    <string>-n</string>
    <string>10</string>
    <string>/bin/bash</string>
    <string>/Users/for_you/ForYou/main/scripts/backup-catalog-media-to-dropbox.command</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/for_you/ForYou/main</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>FORYOU_MEDIA_BACKUP_ROOT</key>
    <string>/Users/for_you/Library/CloudStorage/Dropbox/For You/media database backup</string>
    <key>FORYOU_MEDIA_BACKUP_BWLIMIT_KB</key>
    <string>10240</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/for_you/Library/Logs/ForYou/catalog-media-backup.launchd.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/for_you/Library/Logs/ForYou/catalog-media-backup.launchd.err.log</string>
</dict>
</plist>
